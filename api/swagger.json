                            "type": "file"
                        },
                        "headers": {
                            "Cache-Control": {
                                "type": "string",
                                "description": "max-age=86400"
                            },
                            "ETag": {
                                "type": "string",
                                "description": "Хеш содержимого"
                            }
                        }
                    },
                    "304": {
                        "description": "Не изменилась с If-None-Match"
                    },
                    "400": {
                        "description": "Неверный запрос, нет аватарки или сбой",
