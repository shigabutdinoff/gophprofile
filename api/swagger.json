        "/api/v1/avatars": {
            "post": {
                "description": "Принимает jpeg, png или webp до 10 МБ в поле file или image формы.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json",
                    "text/plain"
                ],
                "tags": [
                    "avatars"
                ],
                "summary": "Загрузка аватарки",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Владелец",
                        "name": "X-User-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Картинка",
                        "name": "file",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Картинка, если нет file",
                        "name": "image",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Аватарка принята, миниатюры в работе",
                        "schema": {
                            "$ref": "#/definitions/api.created"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос или сбой",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "details": {
                                    "type": "string"
                                },
                                "error": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "413": {
                        "description": "Файл больше лимита",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "max_size": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Больше 100 запросов в минуту",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Неверный запрос или сбой",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "details": {
                                    "type": "string"
                                },
                                "error": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Неверный запрос или сбой",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "details": {
                                    "type": "string"
                                },
                                "error": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/avatars/{id}": {
